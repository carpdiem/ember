{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3-candidate-row.schema.json",
  "title": "Exact-Hex8 Phase 3 categorical candidate row",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "row_kind", "candidate_id", "bank_kind", "role_order", "serialized_bank", "serialized_bank_sha256", "input_chain_sha256", "search_contract_sha256", "evaluation_stage", "cheap", "primary", "full", "raster_proxy", "pareto", "failures", "strict_pareto_improvement", "cvd", "browser_oracle_status"],
  "dependentRequired": {"run_seed": ["job_index", "job_seed", "proposal_mode", "parent_artifact_sha256", "parent_candidate_ids"], "job_index": ["run_seed", "job_seed", "proposal_mode", "parent_artifact_sha256", "parent_candidate_ids"], "job_seed": ["run_seed", "job_index", "proposal_mode", "parent_artifact_sha256", "parent_candidate_ids"], "proposal_mode": ["run_seed", "job_index", "job_seed", "parent_artifact_sha256", "parent_candidate_ids"], "parent_artifact_sha256": ["run_seed", "job_index", "job_seed", "proposal_mode", "parent_candidate_ids"], "parent_candidate_ids": ["run_seed", "job_index", "job_seed", "proposal_mode", "parent_artifact_sha256"]},
  "properties": {
    "schema_version": {"const": 1},
    "row_kind": {"enum": ["baseline", "candidate"]},
    "candidate_id": {"$ref": "#/$defs/hash"},
    "bank_kind": {"const": "categorical"},
    "role_order": {"const": ["cat.one", "cat.two", "cat.three", "cat.four", "cat.five", "cat.six"]},
    "serialized_bank": {"$ref": "#/$defs/bank"},
    "serialized_bank_sha256": {"$ref": "#/$defs/hash"},
    "input_chain_sha256": {"$ref": "#/$defs/hash"},
    "search_contract_sha256": {"$ref": "#/$defs/hash"},
    "evaluation_stage": {"enum": ["cheap", "primary", "full"]},
    "cheap": {"$ref": "#/$defs/cheap"},
    "primary": {"oneOf": [{"$ref": "#/$defs/transformed"}, {"type": "null"}]},
    "full": {"oneOf": [{"$ref": "#/$defs/transformed"}, {"type": "null"}]},
    "raster_proxy": {"oneOf": [{"$ref": "#/$defs/raster"}, {"type": "null"}]},
    "pareto": {"$ref": "#/$defs/pareto"},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "strict_pareto_improvement": {"type": "boolean"},
    "cvd": {"type": "object", "additionalProperties": false, "required": ["report_only", "used_as_gate", "metrics"], "properties": {"report_only": {"const": true}, "used_as_gate": {"const": false}, "metrics": {"type": "object", "additionalProperties": false, "maxProperties": 0}}},
    "browser_oracle_status": {"const": "NOT_RUN"},
    "run_seed": {"type": "integer", "minimum": 0},
    "job_index": {"type": "integer", "minimum": 0},
    "job_seed": {"type": "integer", "minimum": 0},
    "proposal_mode": {"enum": ["exact-coarse-survivor", "local-mutation-around-coarse-survivor"]},
    "parent_artifact_sha256": {"$ref": "#/$defs/hash"},
    "parent_candidate_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "number": {"type": "number"},
    "bank": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["gate", "actual", "relation", "threshold", "scenario", "roles", "width_css_px"], "properties": {"gate": {"type": "string"}, "actual": {"type": ["number", "string"]}, "relation": {"enum": [">=", "<=", "=="]}, "threshold": {"type": ["number", "string"]}, "scenario": {"type": ["string", "null"]}, "roles": {"type": "array", "items": {"type": "string"}}, "width_css_px": {"type": ["number", "null"]}}, "additionalProperties": false},
    "cheap": {"type": "object", "additionalProperties": false, "required": ["serialized_bank_sha256", "commanded_oklab", "lightness_by_role", "chroma_by_role", "hue_by_role_degrees", "mean_chroma", "pair_min_delta_e_ok", "pair_roles", "neutral_min_delta_e_ok", "neutral_roles", "graphics_contrast_by_background", "graphics_contrast_gate_min", "bg_2_policy", "failures"], "properties": {"serialized_bank_sha256": {"$ref": "#/$defs/hash"}, "commanded_oklab": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}, "lightness_by_role": {"$ref": "#/$defs/sixNumbers"}, "chroma_by_role": {"$ref": "#/$defs/sixNumbers"}, "hue_by_role_degrees": {"$ref": "#/$defs/sixNumbers"}, "mean_chroma": {"type": "number"}, "pair_min_delta_e_ok": {"type": "number"}, "pair_roles": {"$ref": "#/$defs/twoStrings"}, "neutral_min_delta_e_ok": {"type": "number"}, "neutral_roles": {"$ref": "#/$defs/twoStrings"}, "graphics_contrast_by_background": {"type": "object", "additionalProperties": false, "required": ["bg_0", "bg_1", "bg_2"], "properties": {"bg_0": {"type": "number"}, "bg_1": {"type": "number"}, "bg_2": {"type": "number"}}}, "graphics_contrast_gate_min": {"type": "number"}, "bg_2_policy": {"const": "report-only"}, "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}}}},
    "sixNumbers": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}},
    "twoStrings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "transformed": {"type": "object", "additionalProperties": false, "required": ["grid_kind", "scenario_policy", "rows", "summary", "local_refinement", "failures"], "properties": {"grid_kind": {"enum": ["primary-nominal", "full-45-gain-all-viewing-sensitivities"]}, "scenario_policy": {"const": "report separately; never average"}, "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transformedRow"}}, "summary": {"$ref": "#/$defs/transformedSummary"}, "local_refinement": {"$ref": "#/$defs/localRefinement"}, "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}}}},
    "transformedRow": {"type": "object", "additionalProperties": false, "required": ["id", "scenario", "scenario_family", "background", "background_policy", "gain_sample", "gains", "pair_min_cam16_ucs", "pair_roles", "neutral_min_cam16_ucs", "neutral_roles", "graphics_contrast", "j_prime_min", "j_prime_max", "m_prime_max"], "properties": {"id": {"type": "string"}, "scenario": {"type": "string"}, "scenario_family": {"enum": ["primary", "sensitivity"]}, "background": {"enum": ["bg_0", "bg_1", "bg_2"]}, "background_policy": {"enum": ["gate", "report-only"]}, "gain_sample": {"type": "string"}, "gains": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "pair_min_cam16_ucs": {"type": "number"}, "pair_roles": {"$ref": "#/$defs/twoStrings"}, "neutral_min_cam16_ucs": {"type": "number"}, "neutral_roles": {"$ref": "#/$defs/twoStrings"}, "graphics_contrast": {"type": "number"}, "j_prime_min": {"type": "number"}, "j_prime_max": {"type": "number"}, "m_prime_max": {"type": "number"}}},
    "transformedSummary": {"type": "object", "additionalProperties": false, "required": ["sampled_pair_min_cam16_ucs", "pair_binding_row", "sampled_neutral_min_cam16_ucs", "neutral_binding_row", "sampled_graphics_contrast_min", "graphics_contrast_binding_row", "claim"], "properties": {"sampled_pair_min_cam16_ucs": {"type": "number"}, "pair_binding_row": {"type": "string"}, "sampled_neutral_min_cam16_ucs": {"type": "number"}, "neutral_binding_row": {"type": "string"}, "sampled_graphics_contrast_min": {"type": "number"}, "graphics_contrast_binding_row": {"type": "string"}, "claim": {"const": "sampled minimum; not a continuous worst case"}}},
    "localRefinement": {"type": "object", "additionalProperties": false, "required": ["status", "rows"], "properties": {"status": {"enum": ["NOT_TRIGGERED", "TRIGGERED"]}, "rows": {"type": "array", "items": {"$ref": "#/$defs/refinementRow"}}, "binding_row": {"type": "string"}, "margin_fraction": {"type": "number"}, "trigger_fraction": {"type": "number"}, "design": {"const": "deterministic 5 x 5 local subgrid"}, "sample_count": {"const": 25}, "sampled_minimum": {"$ref": "#/$defs/refinementRow"}, "continuous_worst_case_claim": {"const": false}}},
    "refinementRow": {"type": "object", "additionalProperties": false, "required": ["red_gain", "green_gain", "blue_gain", "value"], "properties": {"red_gain": {"type": "number"}, "green_gain": {"type": "number"}, "blue_gain": {"type": "number"}, "value": {"type": "number"}}},
    "raster": {"type": "object", "additionalProperties": false, "required": ["mask_source", "mask_sha256", "mask_count", "geometry_count", "rerasterized", "calibrated_error_margin_delta_e_ok", "minimum_pair_by_width", "claim"], "properties": {"mask_source": {"const": "raster-masks.json"}, "mask_sha256": {"$ref": "#/$defs/hash"}, "mask_count": {"const": 720}, "geometry_count": {"const": 360}, "rerasterized": {"const": false}, "calibrated_error_margin_delta_e_ok": {"type": "number"}, "minimum_pair_by_width": {"type": "object", "additionalProperties": false, "required": ["1.5", "2", "3"], "properties": {"1.5": {"$ref": "#/$defs/rasterMinimum"}, "2": {"$ref": "#/$defs/rasterMinimum"}, "3": {"$ref": "#/$defs/rasterMinimum"}}}, "claim": {"type": "string"}}},
    "rasterMinimum": {"type": "object", "additionalProperties": false, "required": ["calibrated_delta_e_ok", "binding_row"], "properties": {"calibrated_delta_e_ok": {"type": "number"}, "binding_row": {"type": "string"}}},
    "pareto": {"type": "object", "additionalProperties": false, "required": ["transformed_pair_min", "commanded_pair_min", "neutral_min", "graphics_contrast_min", "raster_1_5_min", "raster_2_min", "raster_3_min", "max_commanded_deviation", "mean_commanded_deviation"], "properties": {"transformed_pair_min": {"type": "number"}, "commanded_pair_min": {"type": "number"}, "neutral_min": {"type": "number"}, "graphics_contrast_min": {"type": "number"}, "raster_1_5_min": {"type": ["number", "null"]}, "raster_2_min": {"type": ["number", "null"]}, "raster_3_min": {"type": ["number", "null"]}, "max_commanded_deviation": {"type": "number"}, "mean_commanded_deviation": {"type": "number"}}}
  }
}
